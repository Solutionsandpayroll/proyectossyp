# === Base de Datos (Neon PostgreSQL) ===
DATABASE_URL=postgresql://usuario:contraseña@host/basededatos?sslmode=require

# === JWT ===
JWT_SECRET=clave-secreta-para-firmar-tokens

# === Admin ===
ADMIN_PASSWORD=Admin2025*

# === Mailjet (envío de emails) ===
MAILJET_API_KEY=tu_api_key_de_mailjet
MAILJET_SECRET_KEY=tu_secret_key_de_mailjet
EMAIL_FROM=tu_correo@ejemplo.com
EMAIL_FROM_NAME=SYP
EMAIL_TO=destinatario1@ejemplo.com, destinatario2@ejemplo.com

# === Cloudinary (almacenamiento de imágenes) ===
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# === Entorno ===
NODE_ENV=production
PORT=3000
